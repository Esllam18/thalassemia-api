# =============================================================
# Thalassemia AI API — Environment Variables
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the real values below
#   3. NEVER commit .env to git (it's in .gitignore)
# =============================================================

# ── ML Model ──────────────────────────────────────────────────
# Path to the trained scikit-learn model file.
# Default: same folder as main.py
MODEL_PATH=thalassemia_expert_model.pkl

# Path to the label encoder file.
ENCODER_PATH=label_encoder.pkl

# ── Server ────────────────────────────────────────────────────
# The IP address to listen on. 0.0.0.0 = all network interfaces.
HOST=0.0.0.0

# The port number. Railway uses the PORT env var automatically.
PORT=8000

# Set to 'true' during local development for auto-reload on file changes.
# ALWAYS 'false' in production.
RELOAD=false

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of frontend URLs allowed to call this API.
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088
# Production (replace with your real Vercel URL):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── File Uploads ──────────────────────────────────────────────
# Maximum allowed file size in bytes. Default: 10485760 = 10 MB
MAX_UPLOAD_BYTES=10485760

# ── Medical Constants ─────────────────────────────────────────
# MCV threshold: values >= this are overridden to 'Normal'.
# Based on clinical evidence: thalassemia MCV is always < 80 fL.
MCV_NORMAL_THRESHOLD=81.0
